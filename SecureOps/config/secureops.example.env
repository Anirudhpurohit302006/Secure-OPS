# Copy to config/secureops.env (git-ignored) and fill in real values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secureops
DB_USER=secureops
DB_PASSWORD=CHANGE_ME

# SSH: key-based auth is preferred. The key file stays OUTSIDE the repo.
SSH_PRIVATE_KEY_PATH=C:/Users/YOUR_USER/.ssh/secureops_ed25519
SSH_PRIVATE_KEY_PASSPHRASE=
# Development fallback only (environment only, never stored in PostgreSQL/Git). Leave empty when using a key.
SSH_PASSWORD=
# Populate by running `ssh user@192.168.159.129` once. Enables strict host-key checking.
SSH_KNOWN_HOSTS_PATH=C:/Users/YOUR_USER/.ssh/known_hosts
SSH_CONNECT_TIMEOUT_MS=8000
SSH_COMMAND_TIMEOUT_MS=20000

# Single V1 application user. Generate the hash with scripts/hash-password.ps1
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# 30 minutes is the normal interval; the accepted maximum is 45.
COLLECTION_INTERVAL_MINUTES=30
MONITORED_SERVICES=sshd,firewalld,httpd
